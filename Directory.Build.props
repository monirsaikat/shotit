<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Version>0.1.0</Version>
    <Company>ShotIt</Company>
    <Product>ShotIt</Product>
    <Copyright>Copyright (c) ShotIt contributors</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ShotItWindowsTfm>net10.0-windows10.0.22621.0</ShotItWindowsTfm>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Symbols travel inside the assemblies so crash reports have line numbers without shipping .pdb files. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
